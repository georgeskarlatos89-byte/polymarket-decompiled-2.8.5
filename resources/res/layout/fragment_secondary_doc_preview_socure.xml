<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:paddingTop="48dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="start"
        android:id="@+id/tvDocument"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/socure_consent_title"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:gravity="start"
        android:id="@+id/tvFileNameTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAlignment="viewStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDocument"
        style="@style/socure_consent_title"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/preview_header_bottom_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tvDocument,tvFileNameTitle"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/file_list_scroll"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:fillViewport="false"
        app:layout_constraintBottom_toTopOf="@+id/buttons_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preview_header_bottom_barrier">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/file_list_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/socure_unstructured_card_stroke"
            app:strokeWidth="1dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/file_items_column"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/preview_error_banner"
                    android:background="@color/socure_preview_error_banner_red"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <ImageView
                        android:id="@+id/ivPreviewErrorAlert"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/socure_ic_preview_error_alert"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        app:tint="@android:color/white"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@android:color/white"
                            android:id="@+id/tvPreviewErrorTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/socure_open_sans_bold"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@android:color/white"
                            android:id="@+id/tvPreviewErrorMessage"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/socure_open_sans_regular"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnDismissPreviewError"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/fileItemsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttons_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/tvPoweredBy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.button.MaterialButton
            android:textColor="@android:color/white"
            android:id="@+id/btnUpload"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/submit_document"
            android:textAllCaps="false"
            android:layout_marginHorizontal="12dp"
            app:icon="@drawable/ic_socure_send_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/socure_primary_btn"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cancel"
            android:layout_marginHorizontal="12dp"
            app:icon="@drawable/ic_socure_restart_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnUpload"
            style="@style/socure_btn_teal_stroke"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.socure.docv.capturesdk.common.view.BrandLayout
        android:id="@+id/tvPoweredBy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
