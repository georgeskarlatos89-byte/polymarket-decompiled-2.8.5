<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnCloseMethodSheet"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/socure_close"
        app:srcCompat="@drawable/ic_socure_close_with_circle"/>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="start"
        android:id="@+id/tvSelectMethod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAlignment="viewStart"
        style="@style/socure_consent_title"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/socure_card_background"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/socure_unstructured_card_stroke"
        app:strokeWidth="1dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/scan_text_column"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/ivScanIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/socure_scannerScreen"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_unstructured_photo_camera_24"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivScanIcon"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.button.MaterialButton
                    android:textSize="16sp"
                    android:textColor="@color/socure_dark_blue"
                    android:id="@+id/btnScanDocument"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textAllCaps="false"
                    android:fontFamily="@font/socure_open_sans_bold"
                    android:textAlignment="viewStart"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:iconGravity="textStart"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/socure_unstructured_subtitle"
                    android:gravity="start"
                    android:id="@+id/tvScanCardSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/socure_open_sans_regular"
                    android:textAlignment="viewStart"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPhotoLibrary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/socure_card_background"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/socure_unstructured_card_stroke"
        app:strokeWidth="1dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/photo_library_text_column"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/ivPhotoLibraryIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_unstructured_photo_library_24"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivPhotoLibraryIcon"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.button.MaterialButton
                    android:textSize="16sp"
                    android:textColor="@color/socure_dark_blue"
                    android:id="@+id/btnPhotoLibrary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textAllCaps="false"
                    android:fontFamily="@font/socure_open_sans_bold"
                    android:textAlignment="viewStart"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:iconGravity="textStart"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/socure_unstructured_subtitle"
                    android:gravity="start"
                    android:id="@+id/tvPhotoLibrarySubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/socure_open_sans_regular"
                    android:textAlignment="viewStart"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardUpload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/socure_card_background"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/socure_unstructured_card_stroke"
        app:strokeWidth="1dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/upload_text_column"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/ivUploadIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/socure_unstructured_intro_continue"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_unstructured_upload_file_24"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivUploadIcon"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.button.MaterialButton
                    android:textSize="16sp"
                    android:textColor="@color/socure_dark_blue"
                    android:id="@+id/btnUpload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textAllCaps="false"
                    android:fontFamily="@font/socure_open_sans_bold"
                    android:textAlignment="viewStart"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:iconGravity="textStart"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/socure_unstructured_subtitle"
                    android:gravity="start"
                    android:id="@+id/tvPhotoUpload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/socure_open_sans_regular"
                    android:textAlignment="viewStart"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView
        android:id="@+id/tvDocument"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/tvDocumentsCollected"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttons_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/disclaimer_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/socure_dark_blue"
            android:gravity="start"
            android:id="@+id/tvDisclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/socure_unstructured_disclaimer"
            android:lineSpacingExtra="3dp"
            android:fontFamily="@font/socure_open_sans_regular"/>
    </LinearLayout>
    <com.socure.docv.capturesdk.common.view.BrandLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/tvPoweredByMethod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"/>
</LinearLayout>
