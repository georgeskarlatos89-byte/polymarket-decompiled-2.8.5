<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/intro_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/intro_scroll"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:layout_constraintBottom_toTopOf="@+id/btnIntroContinue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ivCustomLogo"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:textSize="22sp"
                    android:textColor="@color/socure_dark_blue"
                    android:gravity="start"
                    android:id="@+id/tvIntroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="@font/socure_open_sans_bold"
                    android:textAlignment="viewStart"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/rvDocTypesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/socure_unstructured_card_stroke"
                    app:strokeWidth="1dp">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDocTypes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIntroContinue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/socure_unstructured_intro_continue"
            android:textAllCaps="false"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintBottom_toTopOf="@+id/tvPoweredBy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/socure_primary_btn"/>
        <com.socure.docv.capturesdk.common.view.BrandLayout
            android:id="@+id/tvPoweredBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/method_sheet_scrim"
            android:background="#99000000"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/method_bottom_sheet"
        android:background="@drawable/socure_unstructured_sheet_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="12dp"
        app:behavior_hideable="true"
        app:behavior_peekHeight="1dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/socure_bottom_sheet_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"/>
        <androidx.core.widget.NestedScrollView
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">
            <include
                android:id="@+id/methodContent"
                layout="@layout/unstructured_doc_method_panel"/>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <LinearLayout
        android:gravity="top"
        android:orientation="vertical"
        android:id="@+id/accepted_docs_bottom_sheet"
        android:background="@drawable/socure_unstructured_sheet_background"
        android:paddingBottom="24dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:elevation="16dp"
        app:behavior_hideable="true"
        app:behavior_peekHeight="1dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/socure_bottom_sheet_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"/>
        <TextView
            android:textSize="22sp"
            android:textColor="@color/socure_dark_blue"
            android:gravity="start"
            android:id="@+id/tvAcceptedDocsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/socure_unstructured_accepted_documents_title"
            android:lineSpacingExtra="4dp"
            android:fontFamily="@font/socure_open_sans_bold"
            android:textAlignment="viewStart"/>
        <View
            android:id="@+id/acceptedDocsDivider"
            android:background="@color/socure_unstructured_card_stroke"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"/>
        <androidx.core.widget.NestedScrollView
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:fillViewport="true"
            android:layout_weight="1">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/socure_dark_blue"
                android:gravity="start|top"
                android:id="@+id/tvAcceptedDocsList"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:fontFamily="@font/socure_open_sans_regular"
                android:textAlignment="viewStart"/>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
